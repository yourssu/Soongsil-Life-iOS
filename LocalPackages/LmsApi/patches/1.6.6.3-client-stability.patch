+    private fun extractElementBodies(source: String, tagNames: List<String>): List<String> {
+        val result = mutableListOf<String>()
+        var searchIndex = 0
+
+        while (searchIndex < source.length) {
+            val nextTag = tagNames.mapNotNull { tagName ->
+                findOpeningTag(source, tagName, searchIndex)?.let { tagName to it }
+            }.minByOrNull { it.second } ?: break
+
+            val tagName = nextTag.first
+            val openingStart = nextTag.second
+            val contentStart = source.indexOf('>', openingStart + tagName.length + 1)
+            if (contentStart < 0) break
+            val closingStart = source.indexOf(
+                "</$tagName>",
+                contentStart + 1,
+                ignoreCase = true,
+            )
+            if (closingStart < 0) {
+                searchIndex = contentStart + 1
+                continue
+            }
+
+            result += source.substring(contentStart + 1, closingStart)
+            searchIndex = closingStart + tagName.length + 3
+        }
+        return result
+    }
+
+    private fun findOpeningTag(source: String, tagName: String, fromIndex: Int): Int? {
+        var searchIndex = fromIndex
+        val marker = "<$tagName"
+        while (searchIndex < source.length) {
+            val candidate = source.indexOf(marker, searchIndex, ignoreCase = true)
+            if (candidate < 0) return null
+            val boundaryIndex = candidate + marker.length
+            if (
+                boundaryIndex >= source.length ||
+                source[boundaryIndex].isWhitespace() ||
+                source[boundaryIndex] == '>'
+            ) {
+                return candidate
+            }
+            searchIndex = boundaryIndex
+        }
+        return null
+    }
