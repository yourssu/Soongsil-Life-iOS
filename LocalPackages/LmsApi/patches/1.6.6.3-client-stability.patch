+private fun String.htmlTagEnd(tagStart: Int): Int? {
+    if (regionMatches(tagStart, "<!--", 0, 4)) {
+        val commentEnd = indexOf("-->", tagStart + 4)
+        return commentEnd.takeIf { it >= 0 }?.plus(2)
+    }
+
+    var cursor = tagStart + 1
+    if (cursor < length && this[cursor] == '/') cursor++
+    if (cursor >= length || !this[cursor].isAsciiHtmlNameStart()) return null
+    cursor++
+    while (cursor < length && this[cursor].isAsciiHtmlNameCharacter()) cursor++
+
+    var quote: Char? = null
+    while (cursor < length) {
+        val character = this[cursor]
+        if (quote != null) {
+            if (character == quote) quote = null
+        } else if (character == '"' || character == '\'') {
+            quote = character
+        } else if (character == '<') {
+            return null
+        } else if (character == '>') {
+            return cursor
+        }
+        cursor++
+    }
+    return null
+}
+
+private fun Char.isAsciiHtmlNameStart(): Boolean {
+    return this in 'a'..'z' || this in 'A'..'Z'
+}
+
+private fun Char.isAsciiHtmlNameCharacter(): Boolean {
+    return isAsciiHtmlNameStart() || isDigit() || this == ':' || this == '_' || this == '-'
+}
+
+private fun decodeHtmlEntityToken(token: String): String? {
+    if (token.startsWith("#")) {
+        val number = token.substring(1)
+        val codePoint = runCatching {
+            if (number.startsWith("x", ignoreCase = true)) {
+                number.substring(1).toInt(16)
+            } else {
+                number.toInt()
+            }
+        }.getOrNull() ?: return null
+        return codePoint.toChar().toString()
+    }
+
+    return when (token) {
+        "nbsp" -> " "
+        "lt" -> "<"
+        "gt" -> ">"
+        "amp" -> "&"
+        "quot" -> "\""
+        "apos" -> "'"
+        else -> null
+    }
+}
