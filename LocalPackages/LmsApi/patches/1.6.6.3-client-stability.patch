+private fun largestCdataBody(source: String): String? {
+    val opening = "<![CDATA["
+    val closing = "]] >".replace(" ", "")
+    var searchIndex = 0
+    var largest: String? = null
+
+    while (searchIndex < source.length) {
+        val start = source.indexOf(opening, searchIndex)
+        if (start < 0) break
+        val contentStart = start + opening.length
+        val end = source.indexOf(closing, contentStart)
+        if (end < 0) break
+        if (largest == null || end - contentStart > largest.length) {
+            largest = source.substring(contentStart, end)
+        }
+        searchIndex = end + closing.length
+    }
+    return largest
+}
