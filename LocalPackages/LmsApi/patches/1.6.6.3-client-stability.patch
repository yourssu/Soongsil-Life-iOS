+package io.github.chlwhdtn03.internal
+
+import io.github.chlwhdtn03.stripHtmlTags
+
+/**
+ * A small, non-recursive HTML scanner for the SAP WebDynpro fragments used by the client.
+ *
+ * Kotlin/Native's regex engine recursively evaluates reluctant/tempered quantifiers. Large
+ * single-line WebDynpro responses can therefore exhaust the native thread stack. These helpers
+ * deliberately scan each character iteratively instead of using a general-purpose HTML regex.
+ */
+internal data class HtmlTagSlice(
+    val name: String,
+    val start: Int,
+    val endExclusive: Int,
+    val isClosing: Boolean,
+    val isSelfClosing: Boolean,
+    val source: String,
+) {
+    fun attribute(name: String): String? {
+        var cursor = start + 1
+        if (cursor < endExclusive && source[cursor] == '/') cursor++
+        while (cursor < endExclusive && source[cursor].isWhitespace()) cursor++
+        while (cursor < endExclusive && isHtmlNameCharacter(source[cursor])) cursor++
+
+        while (cursor < endExclusive) {
+            while (cursor < endExclusive && source[cursor].isWhitespace()) cursor++
+            if (cursor >= endExclusive || source[cursor] == '>' || source[cursor] == '/') break
+
+            val attributeStart = cursor
+            while (
+                cursor < endExclusive &&
+                !source[cursor].isWhitespace() &&
+                source[cursor] != '=' &&
+                source[cursor] != '>' &&
+                source[cursor] != '/'
+            ) {
+                cursor++
+            }
+            val attributeName = source.substring(attributeStart, cursor)
+            while (cursor < endExclusive && source[cursor].isWhitespace()) cursor++
+            if (cursor >= endExclusive || source[cursor] != '=') {
+                if (attributeName.equals(name, ignoreCase = true)) return ""
+                continue
+            }
+
+            cursor++
+            while (cursor < endExclusive && source[cursor].isWhitespace()) cursor++
+            if (cursor >= endExclusive) return null
+
+            val quote = source[cursor]
+            val valueStart: Int
+            val valueEnd: Int
+            if (quote == '"' || quote == '\'') {
+                valueStart = cursor + 1
+                cursor = valueStart
+                while (cursor < endExclusive && source[cursor] != quote) cursor++
+                valueEnd = cursor
+                if (cursor < endExclusive) cursor++
+            } else {
+                valueStart = cursor
+                while (
+                    cursor < endExclusive &&
+                    !source[cursor].isWhitespace() &&
+                    source[cursor] != '>'
+                ) {
+                    cursor++
+                }
+                valueEnd = cursor
+            }
+            if (attributeName.equals(name, ignoreCase = true)) {
+                return source.substring(valueStart, valueEnd)
+            }
+        }
+        return null
+    }
+}
+
+internal data class HtmlElementSlice(
+    val openingTag: HtmlTagSlice,
+    val contentStart: Int,
+    val contentEnd: Int,
+    val endExclusive: Int,
+) {
+    fun content(source: String): String = source.substring(contentStart, contentEnd)
+}
+
+internal fun nextHtmlTag(
+    source: String,
+    startIndex: Int = 0,
+    limit: Int = source.length,
+): HtmlTagSlice? {
+    var searchIndex = startIndex.coerceAtLeast(0)
+    val safeLimit = limit.coerceAtMost(source.length)
+    tagSearch@ while (searchIndex < safeLimit) {
+        val tagStart = source.indexOf('<', searchIndex)
+        if (tagStart < 0 || tagStart >= safeLimit) return null
+
+        if (source.regionMatches(tagStart, "<!--", 0, 4, ignoreCase = false)) {
+            val commentEnd = source.indexOf("-->", tagStart + 4)
+            if (commentEnd < 0 || commentEnd >= safeLimit) return null
+            searchIndex = commentEnd + 3
+            continue
+        }
+
+        var cursor = tagStart + 1
+        var isClosing = false
+        if (cursor < safeLimit && source[cursor] == '/') {
+            isClosing = true
+            cursor++
+        }
+        if (cursor >= safeLimit || !isHtmlNameStartCharacter(source[cursor])) {
+            searchIndex = tagStart + 1
+            continue
+        }
+        val nameStart = cursor
+        while (cursor < safeLimit && isHtmlNameCharacter(source[cursor])) cursor++
+
+        val name = source.substring(nameStart, cursor)
+        var quote: Char? = null
+        while (cursor < safeLimit) {
+            val character = source[cursor]
+            if (quote != null) {
+                if (character == quote) quote = null
+            } else if (character == '"' || character == '\'') {
+                quote = character
+            } else if (character == '<') {
+                searchIndex = cursor
+                continue@tagSearch
+            } else if (character == '>') {
+                var slashIndex = cursor - 1
+                while (slashIndex > nameStart && source[slashIndex].isWhitespace()) slashIndex--
+                val tag = HtmlTagSlice(
+                    name = name,
+                    start = tagStart,
+                    endExclusive = cursor + 1,
+                    isClosing = isClosing,
+                    isSelfClosing = !isClosing && source[slashIndex] == '/',
+                    source = source,
+                )
+                if (!tag.isClosing && !tag.isSelfClosing && tag.name.isRawTextElement()) {
+                    val rawTextEnd = findRawTextElementEnd(source, tag, safeLimit)
+                        ?: return null
+                    searchIndex = rawTextEnd
+                    continue@tagSearch
+                }
+                return tag
+            }
+            cursor++
+        }
+        return null
+    }
+    return null
+}
+
+/**
+ * Finds every element with [tagName], including same-name elements nested inside another match.
+ *
+ * [findHtmlElements] intentionally returns only outermost same-name elements, which is useful
+ * when extracting the direct cells of a row. WebDynpro pages, however, commonly place result
+ * tables inside layout tables. Page-level row/table discovery must use this variant so an outer
+ * layout `<tr>` cannot hide the result table's `<tr>` elements.
+ */
+internal fun findNestedHtmlElements(
+    source: String,
+    tagName: String,
+    startIndex: Int = 0,
+    limit: Int = source.length,
+): List<HtmlElementSlice> {
+    val safeStart = startIndex.coerceAtLeast(0)
+    val safeLimit = limit.coerceAtMost(source.length)
+    if (safeStart >= safeLimit) return emptyList()
+
+    val elementsInOpeningOrder = mutableListOf<HtmlElementSlice?>()
+    val openElements = mutableListOf<Pair<Int, HtmlTagSlice>>()
+    var cursor = safeStart
+    while (cursor < safeLimit) {
+        val tag = nextHtmlTag(source, cursor, safeLimit) ?: break
+        if (tag.name.equals(tagName, ignoreCase = true)) {
+            if (tag.isClosing) {
+                if (openElements.isNotEmpty()) {
+                    val (resultIndex, openingTag) = openElements.removeAt(openElements.lastIndex)
+                    elementsInOpeningOrder[resultIndex] = HtmlElementSlice(
+                        openingTag = openingTag,
+                        contentStart = openingTag.endExclusive,
+                        contentEnd = tag.start,
+                        endExclusive = tag.endExclusive,
+                    )
+                }
+            } else if (tag.isSelfClosing) {
+                elementsInOpeningOrder += HtmlElementSlice(
+                    openingTag = tag,
+                    contentStart = tag.endExclusive,
+                    contentEnd = tag.endExclusive,
+                    endExclusive = tag.endExclusive,
+                )
+            } else {
+                val resultIndex = elementsInOpeningOrder.size
+                elementsInOpeningOrder += null
+                openElements += resultIndex to tag
+            }
+        }
+        cursor = tag.endExclusive
+    }
+    return elementsInOpeningOrder.filterNotNull()
+}
+
+internal fun findHtmlElements(
+    source: String,
+    tagName: String,
+    startIndex: Int = 0,
+    limit: Int = source.length,
+): List<HtmlElementSlice> {
+    val result = mutableListOf<HtmlElementSlice>()
+    var cursor = startIndex.coerceAtLeast(0)
+    val safeLimit = limit.coerceAtMost(source.length)
+    while (cursor < safeLimit) {
+        val openingTag = nextTagNamed(source, tagName, cursor, safeLimit, closing = false) ?: break
+        val element = htmlElementFromOpeningTag(source, openingTag, safeLimit)
+        if (element != null) {
+            result += element
+            cursor = element.endExclusive.coerceAtLeast(openingTag.endExclusive)
+        } else {
+            cursor = openingTag.endExclusive
+        }
+    }
+    return result
+}
+
+internal fun findOpeningHtmlTags(
+    source: String,
+    tagNames: Set<String>,
+    startIndex: Int = 0,
+    limit: Int = source.length,
+): List<HtmlTagSlice> {
+    if (tagNames.isEmpty()) return emptyList()
+    val normalizedNames = tagNames.mapTo(mutableSetOf()) { it.lowercase() }
+    val result = mutableListOf<HtmlTagSlice>()
+    var cursor = startIndex.coerceAtLeast(0)
+    val safeLimit = limit.coerceAtMost(source.length)
+    while (cursor < safeLimit) {
+        val tag = nextHtmlTag(source, cursor, safeLimit) ?: break
+        if (!tag.isClosing && tag.name.lowercase() in normalizedNames) result += tag
+        cursor = tag.endExclusive
+    }
+    return result
+}
+
+internal fun findHtmlElements(
+    source: String,
+    tagNames: Set<String>,
+    startIndex: Int = 0,
+    limit: Int = source.length,
+): List<HtmlElementSlice> {
+    if (tagNames.isEmpty()) return emptyList()
+    val normalizedNames = tagNames.mapTo(mutableSetOf()) { it.lowercase() }
+    val result = mutableListOf<HtmlElementSlice>()
+    var cursor = startIndex.coerceAtLeast(0)
+    val safeLimit = limit.coerceAtMost(source.length)
+    while (cursor < safeLimit) {
+        val openingTag = nextOpeningTagNamed(source, normalizedNames, cursor, safeLimit) ?: break
+        val element = htmlElementFromOpeningTag(source, openingTag, safeLimit)
+        if (element != null) {
+            result += element
+            cursor = element.endExclusive.coerceAtLeast(openingTag.endExclusive)
+        } else {
+            cursor = openingTag.endExclusive
+        }
+    }
+    return result
+}
+
+internal fun findLabeledControlId(source: String, labelText: String): String? {
+    var cursor = 0
+    while (cursor < source.length) {
+        val openingTag = nextTagNamed(source, "label", cursor, source.length, closing = false)
+            ?: return null
+        val element = htmlElementFromOpeningTag(source, openingTag, source.length)
+        if (element != null) {
+            val text = element.content(source).stripHtmlTags()
+            if (text.contains(labelText, ignoreCase = true)) {
+                openingTag.attribute("for")?.takeIf { it.isNotBlank() }?.let { return it }
+            }
+        }
+        cursor = openingTag.endExclusive
+    }
+    return null
+}
+
+internal fun findControlIdBySuffix(source: String, suffix: String): String? {
+    var cursor = 0
+    while (cursor < source.length) {
+        val tag = nextHtmlTag(source, cursor) ?: return null
+        if (!tag.isClosing) {
+            tag.attribute("id")?.takeIf { it.endsWith(suffix, ignoreCase = true) }?.let { return it }
+        }
+        cursor = tag.endExclusive
+    }
+    return null
+}
+
+internal fun findSearchButtonId(source: String, fallbackSuffix: String): String? {
+    var cursor = 0
+    while (cursor < source.length) {
+        val tag = nextHtmlTag(source, cursor) ?: break
+        if (
+            !tag.isClosing &&
+            (tag.name.equals("button", ignoreCase = true) ||
+                tag.name.equals("div", ignoreCase = true)) &&
+            tag.attribute("ct").equals("B", ignoreCase = true)
+        ) {
+            val id = tag.attribute("id")
+            val element = htmlElementFromOpeningTag(source, tag, source.length)
+            if (
+                !id.isNullOrBlank() &&
+                element?.content(source)?.stripHtmlTags()?.contains("조회", ignoreCase = true) == true
+            ) {
+                return id
+            }
+        }
+        cursor = tag.endExclusive
+    }
+    return findControlIdBySuffix(source, fallbackSuffix)
+}
+
+internal fun findControlValue(source: String, labelText: String): String? {
+    val id = findLabeledControlId(source, labelText)
+    if (!id.isNullOrBlank()) {
+        var cursor = 0
+        while (cursor < source.length) {
+            val tag = nextHtmlTag(source, cursor) ?: break
+            if (!tag.isClosing && tag.attribute("id").equals(id, ignoreCase = true)) {
+                tag.attribute("value")?.takeIf { it.isNotBlank() }?.let { return it }
+            }
+            cursor = tag.endExclusive
+        }
+    }
+
+    var cursor = 0
+    while (cursor < source.length) {
+        val tag = nextHtmlTag(source, cursor) ?: return null
+        if (!tag.isClosing) {
+            tag.attribute("value")
+                ?.takeIf { it.contains(labelText, ignoreCase = true) }
+                ?.let { return it }
+        }
+        cursor = tag.endExclusive
+    }
+    return null
+}
+
+private fun nextTagNamed(
+    source: String,
+    tagName: String,
+    startIndex: Int,
+    limit: Int,
+    closing: Boolean? = null,
+): HtmlTagSlice? {
+    var cursor = startIndex
+    while (cursor < limit) {
+        val tag = nextHtmlTag(source, cursor, limit) ?: return null
+        if (
+            tag.name.equals(tagName, ignoreCase = true) &&
+            (closing == null || tag.isClosing == closing)
+        ) {
+            return tag
+        }
+        cursor = tag.endExclusive
+    }
+    return null
+}
+
+private fun nextOpeningTagNamed(
+    source: String,
+    normalizedNames: Set<String>,
+    startIndex: Int,
+    limit: Int,
+): HtmlTagSlice? {
+    var cursor = startIndex
+    while (cursor < limit) {
+        val tag = nextHtmlTag(source, cursor, limit) ?: return null
+        if (!tag.isClosing && tag.name.lowercase() in normalizedNames) return tag
+        cursor = tag.endExclusive
+    }
+    return null
+}
+
+private fun htmlElementFromOpeningTag(
+    source: String,
+    openingTag: HtmlTagSlice,
+    limit: Int,
+): HtmlElementSlice? {
+    if (openingTag.isClosing) return null
+    if (openingTag.isSelfClosing) {
+        return HtmlElementSlice(
+            openingTag = openingTag,
+            contentStart = openingTag.endExclusive,
+            contentEnd = openingTag.endExclusive,
+            endExclusive = openingTag.endExclusive,
+        )
+    }
+
+    var cursor = openingTag.endExclusive
+    var depth = 1
+    while (cursor < limit) {
+        val tag = nextTagNamed(source, openingTag.name, cursor, limit) ?: return null
+        if (tag.isClosing) {
+            depth--
+            if (depth == 0) {
+                return HtmlElementSlice(
+                    openingTag = openingTag,
+                    contentStart = openingTag.endExclusive,
+                    contentEnd = tag.start,
+                    endExclusive = tag.endExclusive,
+                )
+            }
+        } else if (!tag.isSelfClosing) {
+            depth++
+        }
+        cursor = tag.endExclusive
+    }
+    return null
+}
+
+private fun isHtmlNameCharacter(character: Char): Boolean {
+    return isHtmlNameStartCharacter(character) ||
+        character.isDigit() ||
+        character == ':' ||
+        character == '_' ||
+        character == '-'
+}
+
+private fun isHtmlNameStartCharacter(character: Char): Boolean {
+    return character in 'a'..'z' || character in 'A'..'Z'
+}
+
+private fun String.isRawTextElement(): Boolean {
+    return equals("script", ignoreCase = true) || equals("style", ignoreCase = true)
+}
+
+private fun findRawTextElementEnd(
+    source: String,
+    openingTag: HtmlTagSlice,
+    limit: Int,
+): Int? {
+    val marker = "</${openingTag.name}"
+    var searchIndex = openingTag.endExclusive
+    while (searchIndex < limit) {
+        val closingStart = source.indexOf('<', searchIndex)
+        if (closingStart < 0 || closingStart + marker.length > limit) return null
+        val boundaryIndex = closingStart + marker.length
+        if (
+            !source.regionMatches(closingStart, marker, 0, marker.length, ignoreCase = true) ||
+            boundaryIndex < limit &&
+            !source[boundaryIndex].isWhitespace() &&
+            source[boundaryIndex] != '>'
+        ) {
+            searchIndex = closingStart + 1
+            continue
+        }
+        val closingEnd = source.indexOf('>', boundaryIndex)
+        return if (closingEnd in boundaryIndex until limit) closingEnd + 1 else null
+    }
+    return null
+}
