+private fun findTagByAttribute(
+    html: String,
+    attributeName: String,
+    attributeValue: String,
+    tagName: String? = null,
+): String? {
+    var searchIndex = 0
+    while (searchIndex < html.length) {
+        val start = html.indexOf('<', searchIndex)
+        if (start < 0) return null
+        val end = html.indexOf('>', start + 1)
+        if (end < 0) return null
+        val tag = html.substring(start, end + 1)
+        val actualTagName = tag
+            .drop(1)
+            .trimStart()
+            .takeWhile { !it.isWhitespace() && it != '>' && it != '/' }
+        if (
+            (tagName == null || actualTagName.equals(tagName, ignoreCase = true)) &&
+            tag.htmlAttribute(attributeName).equals(attributeValue, ignoreCase = true)
+        ) {
+            return tag
+        }
+        searchIndex = end + 1
+    }
+    return null
+}
+
+private fun String.htmlAttribute(name: String): String? {
+    var searchIndex = 0
+    while (searchIndex < length) {
+        val nameIndex = indexOf(name, searchIndex, ignoreCase = true)
+        if (nameIndex < 0) return null
+        val beforeIsBoundary = nameIndex == 0 || !this[nameIndex - 1].isLetterOrDigit()
+        var cursor = nameIndex + name.length
+        val afterIsBoundary = cursor >= length || !this[cursor].isLetterOrDigit()
+        if (!beforeIsBoundary || !afterIsBoundary) {
+            searchIndex = cursor
+            continue
+        }
+
+        while (cursor < length && this[cursor].isWhitespace()) cursor++
+        if (cursor >= length || this[cursor] != '=') {
+            searchIndex = cursor
+            continue
+        }
+        cursor++
+        while (cursor < length && this[cursor].isWhitespace()) cursor++
+        if (cursor >= length) return null
+
+        val quote = this[cursor]
+        if (quote == '\"' || quote == '\'') {
+            val valueStart = cursor + 1
+            val valueEnd = indexOf(quote, valueStart)
+            return if (valueEnd >= 0) substring(valueStart, valueEnd) else null
+        }
+
+        val valueEnd = indexOfFirstFrom(cursor) { it.isWhitespace() || it == '>' }
+        return substring(cursor, valueEnd)
+    }
+    return null
+}
+
+private inline fun String.indexOfFirstFrom(
+    startIndex: Int,
+    predicate: (Char) -> Boolean,
+): Int {
+    for (index in startIndex until length) {
+        if (predicate(this[index])) return index
+    }
+    return length
+}
+
+private fun findElementBody(html: String, tagName: String): String? {
+    val openStart = html.indexOf("<$tagName", ignoreCase = true)
+    if (openStart < 0) return null
+    val contentStart = html.indexOf('>', openStart + tagName.length + 1)
+    if (contentStart < 0) return null
+    val end = html.indexOf("</$tagName>", contentStart + 1, ignoreCase = true)
+    if (end < 0) return null
+    return html.substring(contentStart + 1, end)
+}
